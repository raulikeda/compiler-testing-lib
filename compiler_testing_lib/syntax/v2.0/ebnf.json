"PROGRAM = { STATEMENT } ;\nSTATEMENT = ((IDENTIFIER, \"=\", EXPRESSION) | (PRINT, \"(\", EXPRESSION, \")\") | ε), EOL ;\nEXPRESSION = TERM, { (\"+\" | \"-\"), TERM } ;\nTERM = FACTOR, { (\"*\" | \"/\"), FACTOR } ;\nFACTOR = (\"+\" | \"-\"), FACTOR | \"(\", EXPRESSION, \")\" | NUMBER ;\nNUMBER = DIGIT, {DIGIT} ;\nDIGIT = 0 | 1 | ... | 9 ;\nIDENTIFIER = LETTER, {LETTER | DIGIT | \"_\"} ;\nLETTER = a | b | ... | z | A | B | ... | Z ;"